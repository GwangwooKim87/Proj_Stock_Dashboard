# ============================================================
# Personal Stock Dashboard - API keys reference (.env.example)
# Copy this file to .env, then fill in real values. (All below commented)
# [ACCOUNT ORDER] Do NOT hardcode account numbers/order. The dashboard
#   auto-fetchesthe account list from each broker and stores it in accounts
#   table sorted by display_order (broker-returned order.

# ------------------------------------------------------------
# Kiwoom REST API (domestic ISA)
# URL: https://openapi.kiwoom.com   register App, issue per-account App Key/Secret
#KIWOOM_APP_KEY=
#KIWOOM_APP_SECRET=
#KIWOOM_ACCOUNT_NO=
#KIWOOM_SERVER=real              # real(live) | demo(paper
#KIWOOM_IP_ALLOWLIST=           # this server's public IP (allowlist

# ------------------------------------------------------------
# Toss Open API (overseas) - OAuth2 client id / secret
# URL: https://corp.tossinvest.com/ko/open-api  (Toss account holders only
# Auth: exchange client id/secret for OAuth2 token at runtime; Bearer on calls.


#TOSSINVEST_CLIENT_ID=
#TOSSINVEST_CLIENT_SECRET=
#TOSSINVEST_ACCOUNT_SEQ=
#TOSSINVEST_SCOPE=

# ------------------------------------------------------------
# FX rate (USD -> KRW base) - realtime mid or prior-day close
# Exchange API URL (base=USD). Default: https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_API_URL=

# ------------------------------------------------------------
# Naver Finance news (AI input filtering source)
#NAVER_NEWS_TIMEOUT=5

# ------------------------------------------------------------
# AI (morning briefing) - handled directly by Hermes Agent
# Dashboard container has NO AI module. Hermes generates briefing via
# DeepSeek v4 Flash(OpenRouter and writes morning_feed / delivers.
#   (No separate DEEPSEEK_API_KEY needed)

# ------------------------------------------------------------
# Dashboard port
#DASHBOARD_PORT=8080